# ===== App (frontend + API) =====
APP_HOST=127.0.0.1
APP_PORT=8000
APP_URL=http://127.0.0.1:8000

# ===== Game site (change here when needed) =====
GAME_SITE=damanvipgames.com
GAME_LOGIN_URL=https://damanvipgames.com/#/login
GAME_WINGO_URL=https://damanvipgames.com/#/saas/Lottery/WinGo?gameCode=WinGo_30S&lottery=WinGo

# ===== Chrome =====
# Local Windows: visible Chrome + new tab
HEADLESS=0
CHROME_DEBUG=1
CHROME_DEBUG_HOST=127.0.0.1
CHROME_DEBUG_PORT=9222

# ===== MySQL (fill in your values) =====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=automection

# ===== App auth / sessions (APK infrastructure) =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
CHROME_PROFILES_ROOT=/home/updowanfx/chrome-profiles
SESSION_DISPLAY_BASE=100
SESSION_DISPLAY_WIDTH=1920
SESSION_DISPLAY_HEIGHT=1080
SESSION_DISPLAY_DEPTH=24
CAPTURE_FPS=8

# ===== WebRTC (live view) =====
WEBRTC_BACKEND=aiortc
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=
